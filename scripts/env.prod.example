# ==============================================================================
# Environment Configuration (Production) - SIAKAD YAPI
# Domain: siakad.yapinet.id
# ==============================================================================

APP_NAME="Siakad YAPI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://siakad.yapinet.id

# Next.js Frontend URL (Same Origin via Nginx Host Proxy)
FRONTEND_URL=https://siakad.yapinet.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=info

# Database PostgreSQL (Internal Docker Container siakad-postgres)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=siakad
DB_USERNAME=siakad
DB_PASSWORD=

# Session & Sanctum SPA Authentication
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_DOMAIN=siakad.yapinet.id
SANCTUM_STATEFUL_DOMAINS=siakad.yapinet.id

# Queue & Cache (Database driver / Redis if enabled)
QUEUE_CONNECTION=database
CACHE_STORE=database

# Integrasi PMB Handoff
PMB_HANDOFF_SECRET=
PMB_BASE_URL=https://pmb.yapinet.id

# Gateway Notifikasi Sendago
SENDAGO_BASE_URL=
SENDAGO_API_KEY=
SENDAGOMAIL_BASE_URL=
SENDAGOMAIL_MEMBER_ID=
SENDAGOMAIL_SECRET=

MAIL_MAILER=log

# Gateway Pembayaran SendagoPay
SENDAGOPAY_PUBLIC_KEY=
SENDAGOPAY_SECRET_KEY=
SENDAGOPAY_WEBHOOK_SECRET=

# Gateway Pembayaran Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
