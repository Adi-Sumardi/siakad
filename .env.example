APP_NAME="Siakad YAPI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Where the Next.js SPA runs. Activation links in invitation emails are built
# from this, so it must point at the frontend, not at the API.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production runs Postgres - see docker-compose.prod.yml
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=siakad
# DB_USERNAME=siakad
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# The handoff job and its invitation email must never run inside a web request.
QUEUE_CONNECTION=database
CACHE_STORE=database

# Shared secret PMB signs every handoff with; must match PMB's
# SCHOOL_HANDOFF_SECRET exactly. Generate with: openssl rand -hex 32
# Left blank, the webhook refuses every request rather than trusting unsigned ones.
PMB_HANDOFF_SECRET=
PMB_BASE_URL=https://pmb.yapinet.id

# Notification gateways, shared with PMB. Blank locally: every send is written
# to the log instead of dispatched, and the whole flow still runs end to end.
SENDAGO_BASE_URL=
SENDAGO_API_KEY=
SENDAGOMAIL_BASE_URL=
SENDAGOMAIL_MEMBER_ID=
SENDAGOMAIL_SECRET=

MAIL_MAILER=log

# Payment Gateway (billing_api / sendagopay / xendit)
PAYMENT_GATEWAY=billing_api

# Web Service Billing API e-SPP (Bank Muamalat BMI Virtual Account)
BILLING_API_BASE_URL=http://43.225.66.150:8061
BILLING_API_CLIENT_ID=
BILLING_API_CLIENT_SECRET=
BILLING_API_USERNAME=
BILLING_API_PASSWORD=
BILLING_API_BANK_ID=1
BILLING_API_BANK_NAME="Bank Muamalat"
BILLING_API_INSTITUTION_CODE=8020
BILLING_API_VA_DUE_DAYS=3
BILLING_API_ADMIN_FEE=0

# Gateway Pembayaran SendagoPay
SENDAGOPAY_PUBLIC_KEY=
SENDAGOPAY_SECRET_KEY=
SENDAGOPAY_WEBHOOK_SECRET=

# Pembayaran Xendit.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
