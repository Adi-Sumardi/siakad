<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- The suite runs the production timezone so the flip is what the
             tests exercise, not a UTC fallback the real app never uses. -->
        <env name="APP_TIMEZONE" value="Asia/Jakarta"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Only needs to be non-empty - BillReminderSender::
             queueSppReminderTemplate() checks this before dispatching, so an
             unset value would silently fall back to "not configured" instead
             of exercising the real send path. QontakWhatsAppGateway itself
             is faked in tests that need it, never actually called with this
             id. -->
        <env name="QONTAK_SPP_REMINDER_TEMPLATE_ID" value="test-spp-reminder-template"/>
        <!-- Same idea for the login OTP: with a template id but no Qontak
             credentials, QontakWhatsAppGateway takes its log-only lane, so a
             test that logs in over WhatsApp without faking the gateway (e.g.
             UserResetAccessTest) still completes instead of 500ing. -->
        <env name="QONTAK_OTP_TEMPLATE_ID" value="test-otp-template"/>
        <!-- A developer .env holding real gateway credentials must never
             reach the suite: any test that doesn't fake a gateway would send
             a real email/WhatsApp (found 2026-09-23, when a missing mail
             template only surfaced on a laptop whose .env had Sendago keys).
             Empty = every gateway takes its log-only lane. -->
        <env name="SENDAGOMAIL_BASE_URL" value="" force="true"/>
        <env name="SENDAGOMAIL_MEMBER_ID" value="" force="true"/>
        <env name="SENDAGOMAIL_SECRET" value="" force="true"/>
        <env name="SENDAGO_BASE_URL" value="" force="true"/>
        <env name="SENDAGO_API_KEY" value="" force="true"/>
        <env name="QONTAK_CLIENT_ID" value="" force="true"/>
        <env name="QONTAK_CLIENT_SECRET" value="" force="true"/>
        <env name="QONTAK_CHANNEL_INTEGRATION_ID" value="" force="true"/>
        <env name="BILLING_API_BASE_URL" value="http://127.0.0.1:9" force="true"/>
        <!-- The webhook refuses unsigned requests, so the suite needs a secret
             to sign with; it must never be a value any environment reuses. -->
        <env name="PMB_HANDOFF_SECRET" value="test-handoff-secret"/>
        <env name="FRONTEND_URL" value="http://localhost:3000"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- CACHE_STORE=array persists for the whole suite, not per-test - a
             real per-minute cap here would eventually throttle a later test's
             WhatsApp send, which under QUEUE_CONNECTION=sync means it never
             actually runs instead of just running late. -->
        <env name="WHATSAPP_SEND_RATE_PER_MINUTE" value="100000"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
